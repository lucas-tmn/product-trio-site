---
interface Props { quote: string; name: string; role: string; initials: string; }
const { quote, name, role, initials } = Astro.props;
---
<figure class="ds-card">
  <div class="quote__who">
    <span class="avatar" aria-hidden="true">{initials}</span>
    <figcaption><span class="ds-h4">{name}</span><br /><span class="ds-caption">{role}</span></figcaption>
  </div>
  <blockquote class="quote__text">{quote}</blockquote>
</figure>
