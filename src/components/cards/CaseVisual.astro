---
// Illustrative stand-in for a project screenshot. Decorative only; swap for real (blurred) visuals later.
interface Props { variant?: number }
const v = (Astro.props.variant ?? 0) % 6;
---
<svg class="case-visual" viewBox="0 0 320 180" role="presentation" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid slice">
  <rect width="320" height="180" fill="var(--indigo-100)" />
  {v === 0 && (<>
    <rect x="16" y="16" width="288" height="22" rx="6" fill="var(--white)" />
    <rect x="24" y="23" width="70" height="8" rx="4" fill="var(--indigo-700)" />
    {[0,1,2].map((c) => [0,1].map((r) => (
      <g>
        <rect x={16 + c * 98} y={50 + r * 56} width="92" height="50" rx="8" fill="var(--white)" />
        <rect x={24 + c * 98} y={58 + r * 56} width="28" height="20" rx="4" fill={(c + r) % 3 === 0 ? 'var(--tangerine-500)' : (c + r) % 3 === 1 ? 'var(--mint-300)' : 'var(--indigo-700)'} />
        <rect x={24 + c * 98} y={84 + r * 56} width="60" height="6" rx="3" fill="var(--indigo-100)" />
      </g>
    )))}
    <rect x="16" y="162" width="288" height="10" rx="5" fill="var(--indigo-700)" />
  </>)}
  {v === 1 && (<>
    <path d="M0 120 C60 90 90 150 160 110 S270 60 320 90" stroke="var(--white)" stroke-width="18" fill="none" />
    <path d="M0 40 L130 70 L210 20 L320 50" stroke="var(--white)" stroke-width="10" fill="none" />
    <path d="M30 140 C90 110 120 130 170 100 S260 80 290 60" stroke="var(--indigo-700)" stroke-width="4" stroke-dasharray="2 8" stroke-linecap="round" fill="none" />
    <circle cx="30" cy="140" r="9" fill="var(--indigo-700)" /><circle cx="170" cy="100" r="9" fill="var(--tangerine-500)" /><circle cx="290" cy="60" r="9" fill="var(--mint-300)" stroke="var(--indigo-700)" stroke-width="3" />
    <rect x="16" y="16" width="96" height="30" rx="8" fill="var(--white)" /><rect x="26" y="26" width="48" height="8" rx="4" fill="var(--indigo-700)" />
  </>)}
  {v === 2 && (<>
    <rect x="16" y="16" width="288" height="148" rx="10" fill="var(--white)" />
    <line x1="48" y1="90" x2="272" y2="90" stroke="var(--indigo-100)" stroke-width="6" stroke-linecap="round" />
    <line x1="48" y1="90" x2="190" y2="90" stroke="var(--indigo-700)" stroke-width="6" stroke-linecap="round" />
    {[48, 120, 190, 272].map((x, i) => <circle cx={x} cy="90" r="11" fill={i < 3 ? 'var(--indigo-700)' : 'var(--white)'} stroke="var(--indigo-700)" stroke-width="3" />)}
    <circle cx="190" cy="90" r="5" fill="var(--tangerine-500)" />
    {[48, 120, 190, 272].map((x) => <rect x={x - 22} y="118" width="44" height="8" rx="4" fill="var(--indigo-100)" />)}
    <rect x="32" y="34" width="90" height="10" rx="5" fill="var(--mint-300)" />
  </>)}
  {v === 3 && (<>
    {[0,1,2].map((i) => (<g><rect x={16 + i * 98} y="16" width="92" height="40" rx="8" fill="var(--white)" /><rect x={26 + i * 98} y="26" width="36" height="6" rx="3" fill="var(--indigo-100)" /><rect x={26 + i * 98} y="38" width="52" height="10" rx="4" fill={i === 1 ? 'var(--tangerine-500)' : 'var(--indigo-700)'} /></g>))}
    <rect x="16" y="68" width="288" height="96" rx="8" fill="var(--white)" />
    {[28, 52, 40, 70, 58, 84, 66].map((h, i) => <rect x={32 + i * 38} y={154 - h} width="24" height={h} rx="4" fill={i === 5 ? 'var(--tangerine-500)' : 'var(--indigo-700)'} />)}
  </>)}
  {v === 4 && (<>
    <rect x="104" y="10" width="112" height="160" rx="16" fill="var(--white)" />
    <rect x="116" y="26" width="88" height="8" rx="4" fill="var(--indigo-700)" />
    <rect x="116" y="42" width="88" height="5" rx="2.5" fill="var(--indigo-100)" />
    {[0,1,2].map((i) => (<g><circle cx="126" cy={72 + i * 26} r="7" fill={i < 2 ? 'var(--mint-300)' : 'var(--white)'} stroke="var(--indigo-700)" stroke-width="2" /><rect x="140" y={69 + i * 26} width="56" height="6" rx="3" fill="var(--indigo-100)" /></g>))}
    <rect x="116" y="146" width="88" height="14" rx="7" fill="var(--tangerine-500)" />
    <rect x="24" y="30" width="60" height="40" rx="8" fill="var(--white)" /><rect x="34" y="42" width="30" height="8" rx="4" fill="var(--mint-300)" /><rect x="34" y="56" width="40" height="6" rx="3" fill="var(--indigo-100)" />
    <rect x="236" y="100" width="60" height="40" rx="8" fill="var(--white)" /><rect x="246" y="112" width="30" height="8" rx="4" fill="var(--tangerine-500)" /><rect x="246" y="126" width="40" height="6" rx="3" fill="var(--indigo-100)" />
  </>)}
  {v === 5 && (<>
    {[[60,50],[130,110],[200,45],[260,100],[160,40]].map(([x,y], i, a) => i < a.length - 1 && <line x1={x} y1={y} x2={a[i+1][0]} y2={a[i+1][1]} stroke="var(--indigo-700)" stroke-width="3" stroke-dasharray="3 7" stroke-linecap="round" />)}
    <line x1="130" y1="110" x2="160" y2="40" stroke="var(--indigo-700)" stroke-width="3" stroke-dasharray="3 7" stroke-linecap="round" />
    {[[60,50],[130,110],[200,45],[260,100],[160,40]].map(([x,y], i) => (<g><circle cx={x} cy={y} r="18" fill="var(--white)" /><circle cx={x} cy={y} r="8" fill={i === 1 ? 'var(--tangerine-500)' : i % 2 ? 'var(--mint-300)' : 'var(--indigo-700)'} /></g>))}
    <rect x="16" y="144" width="140" height="20" rx="10" fill="var(--white)" /><rect x="26" y="151" width="70" height="6" rx="3" fill="var(--indigo-700)" />
  </>)}
</svg>
