---
interface Props { industry: string; title: string; metric: string; metricLabel: string; owner: string; href?: string; [key: string]: unknown; }
const { industry, title, metric, metricLabel, owner, href, ...rest } = Astro.props;
const Tag = href ? 'a' : 'article';
---
<Tag class="ds-card ds-card--case" href={href} {...rest}>
  <span class="ds-eyebrow">{industry}</span>
  <h3 class="ds-h3">{title}</h3>
  <div class="ds-stat"><span class="ds-metric">{metric}</span><span class="ds-stat__label">{metricLabel}</span></div>
  <div class="ds-card--case__owner">{owner}</div>
</Tag>
