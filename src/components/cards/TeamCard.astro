---
import PlaceholderPortrait from './PlaceholderPortrait.astro';
interface Props {
  name: string; role: string; bio: string; photo?: string; linkedin?: string;
  portraitAlt?: string; variant?: number; linkedinLabel?: string; linkedinAria?: string;
}
const { variant = 0, name, role, bio, photo, linkedin, portraitAlt = `Portrait of ${name}`, linkedinLabel = 'LinkedIn', linkedinAria = `LinkedIn profile of ${name}` } = Astro.props;
---
<article class="ds-team">
  <div class="ds-portrait">
    {photo ? <img src={photo} alt={portraitAlt} width="480" height="600" loading="lazy" /> : <PlaceholderPortrait variant={variant} />}
  </div>
  <div><h3 class="ds-h4">{name}</h3><div class="ds-team__role">{role}</div></div>
  <p class="ds-body-s secondary-text team-bio">{bio}</p>
  {linkedin && <a class="ds-link" href={linkedin} rel="noopener" target="_blank" aria-label={linkedinAria}>{linkedinLabel} ↗</a>}
</article>
