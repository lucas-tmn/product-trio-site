---
import '../styles/global.css';
import T from '../components/T.astro';
import c from '../data/content.json';

const initials = (name: string) => name.replace(/[\[\]]/g, '').split(' ').map((p) => p[0]).slice(0, 2).join('');
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.brand.name} · Product, delivery and data/AI</title>
    <meta name="description" content="Senior product, delivery and data/AI team from Vietnam." />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        var saved = localStorage.getItem('lang');
        if (saved === 'vi' || saved === 'en') document.documentElement.setAttribute('data-lang', saved);
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="logo" href="#top">{c.brand.name}</a>
        <nav class="main">
          {c.nav.map((n) => <a href={n.href}><T v={n.label} /></a>)}
        </nav>
        <div class="header-right">
          <div class="lang" role="group" aria-label="Language">
            <button data-set="en" type="button">EN</button>
            <button data-set="vi" type="button">VI</button>
          </div>
          <a class="btn btn-primary" href={c.cta.href}><T v={c.cta.label} /></a>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="wrap">
          <span class="eyebrow"><T v={c.hero.eyebrow} /></span>
          <h1><T v={c.hero.headline} /></h1>
          <p class="sub"><T v={c.hero.sub} /></p>
          <div class="actions">
            <a class="btn btn-primary" href="#contact"><T v={c.hero.primary} /></a>
            <a class="btn btn-ghost" href="#work"><T v={c.hero.secondary} /></a>
          </div>
          <div class="proof">
            {c.proof.map((p) => (
              <div><div class="v">{p.value}</div><div class="l"><T v={p.label} /></div></div>
            ))}
          </div>
        </div>
      </section>

      <section class="problem">
        <div class="wrap">
          <h2><T v={c.problem.title} /></h2>
          <div class="grid">
            {c.problem.items.map((i) => (
              <div class="item"><h3><T v={i.title} /></h3><p><T v={i.body} /></p></div>
            ))}
          </div>
        </div>
      </section>

      <section id="services">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Services</span>
            <h2><T v={c.services.title} /></h2>
          </div>
          <div class="grid-3">
            {c.services.items.map((s) => (
              <div class="card">
                <h3><T v={s.title} /></h3>
                <p><T v={s.body} /></p>
                <div class="tags">{s.tags.map((t) => <span class="tag">{t}</span>)}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="approach" style="background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Approach</span>
            <h2><T v={c.approach.title} /></h2>
          </div>
          <div class="steps">
            {c.approach.steps.map((s) => (
              <div class="step"><span class="n">{s.n}</span><h3><T v={s.title} /></h3><p><T v={s.body} /></p></div>
            ))}
          </div>
          <div class="scale">
            <h3><T v={c.approach.scale.title} /></h3>
            <p><T v={c.approach.scale.body} /></p>
          </div>
        </div>
      </section>

      <section id="work">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Work</span>
            <h2><T v={c.work.title} /></h2>
          </div>
          <div class="filters" id="filters">
            {c.work.filters.map((f, i) => (
              <button type="button" data-filter={f.id} class={i === 0 ? 'active' : ''}><T v={f.label} /></button>
            ))}
          </div>
          <div class="grid-3">
            {c.work.cases.map((k) => (
              <article class="card case" data-type={k.type}>
                <span class="industry"><T v={k.industry} /></span>
                <h3><T v={k.title} /></h3>
                <div class="metric">
                  <div class="v">{k.metric}</div>
                  <div class="l"><T v={k.metricLabel} /></div>
                </div>
                <div class="by">{k.owner}</div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="engage" style="background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Engagement</span>
            <h2><T v={c.engagement.title} /></h2>
          </div>
          <div class="grid-3">
            {c.engagement.items.map((e) => (
              <div class="card">
                <span class="meta"><T v={e.meta} /></span>
                <h3><T v={e.title} /></h3>
                <p><T v={e.body} /></p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="team">
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Team</span>
            <h2><T v={c.team.title} /></h2>
          </div>
          <div class="team-grid">
            {c.team.members.map((m) => (
              <div class="member">
                <div class="photo">
                  {m.photo ? <img src={`${base}${m.photo}`} alt={m.name} /> : initials(m.name)}
                </div>
                <h3>{m.name}</h3>
                <div class="role"><T v={m.role} /></div>
                <p><T v={m.bio} /></p>
                {m.linkedin && <a class="in" href={m.linkedin} rel="noopener" target="_blank">LinkedIn</a>}
              </div>
            ))}
          </div>
          <p class="note"><T v={c.team.note} /></p>
        </div>
      </section>

      <section class="contact" id="contact">
        <div class="wrap">
          <h2><T v={c.contact.title} /></h2>
          <p><T v={c.contact.body} /></p>
          <a class="btn btn-primary" href={`mailto:${c.contact.email}`}>{c.contact.email}</a>
        </div>
      </section>
    </main>

    <footer class="site">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {c.brand.name}</span>
        <span><T v={c.contact.location} /></span>
      </div>
    </footer>

    <script is:inline>
      // language toggle
      document.querySelectorAll('.lang button').forEach(function (b) {
        b.addEventListener('click', function () {
          var l = b.getAttribute('data-set');
          document.documentElement.setAttribute('data-lang', l);
          document.documentElement.lang = l;
          try { localStorage.setItem('lang', l); } catch (e) {}
        });
      });
      // case filter
      var fbtns = document.querySelectorAll('#filters button');
      fbtns.forEach(function (b) {
        b.addEventListener('click', function () {
          var f = b.getAttribute('data-filter');
          fbtns.forEach(function (x) { x.classList.toggle('active', x === b); });
          document.querySelectorAll('.case').forEach(function (c) {
            c.classList.toggle('hidden', f !== 'all' && c.getAttribute('data-type') !== f);
          });
        });
      });
    </script>
  </body>
</html>
